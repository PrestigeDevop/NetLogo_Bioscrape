<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[extensions [py]

breed [motif-nodes motif-node]
breed [cell-markers cell-marker]

directed-link-breed [regulations regulation]

motif-nodes-own [
  node-name
  activity
]

globals [
  ready?
  active-mode

  python-path
  backend-file

  simulation-time
  current-input

  activity-A
  activity-B
  activity-C

  baseline-C
  baseline-settled?

  recovery-error
  peak-response
  sensitivity-score
  precision-score
  recovery-time
  run-status
  event-finished?

  sweep-results
  sweep-pass-percent
]


;; ============================================================
;; DECLARED BY INTERFACE WIDGETS, NOT BY GLOBALS:
;;
;; k1 k2 k3 k4 k5 k6
;; initial-A initial-B initial-C
;; motif-mode
;; ligand-level
;; ============================================================


;; ============================================================
;; PRESETS
;; ============================================================

to nfblb-defaults
  set motif-mode "NFBLB"

  set k1 1
  set k2 1
  set k3 0.05
  set k4 0.025
  set k5 10
  set k6 10

  set initial-A 0.5
  set initial-B 0.5
  set initial-C 0.5

  set ligand-level 1.2
end


to ifflp-defaults
  set motif-mode "IFFLP"

  set k1 1
  set k2 1
  set k3 0.05
  set k4 500
  set k5 10
  set k6 10

  set initial-A 0.5
  set initial-B 0.5
  set initial-C 0.5

  set ligand-level 1.2
end


;; ============================================================
;; PARAMETER SNAPSHOT FROM CURRENT WIDGETS
;; ============================================================

to-report current-parameters
  if motif-mode = "NFBLB" [
    report
      (list
        k1 k2 k3 k4 k5 k6
        1 1 0.000001 0.000001 0.05 0.05)
  ]

  report
    (list
      k1 k2 k3 k4 k5 k6
      1 1 0.000001 10000 0.05 0.05)
end


to-report valid-settings?
  if not member? motif-mode ["NFBLB" "IFFLP"] [
    user-message "Choose NFBLB or IFFLP."
    report false
  ]

  if min (list k1 k2 k3 k4 k5 k6) <= 0 [
    user-message "All k values must be positive."
    report false
  ]

  let initial-values
    (list initial-A initial-B initial-C)

  if
    (min initial-values < 0) or
    (max initial-values > 1)
  [
    user-message "Initial activities must be between 0 and 1."
    report false
  ]

  report true
end


;; ============================================================
;; SETUP / RESET
;; ============================================================

to setup
  clear-all
  set ready? false

  ;; EDIT THESE TWO PATHS.
  set python-path
    "D:/programmes/Anaconda/python.exe"

  set backend-file
    "C:/Users/prest/OneDrive/Desktop/adaptation_backend.py"

  if not valid-settings? [
    stop
  ]

  if not file-exists? backend-file [
    user-message "Correct backend-file in setup."
    stop
  ]

  set active-mode motif-mode

  py:setup python-path

  py:set "backend_path" backend-file

  py:run
    "exec(compile(open(backend_path, encoding='utf-8').read(), backend_path, 'exec'))"

  py:set "nl_mode" active-mode
  py:set "nl_parameters" current-parameters

  py:set "nl_initial"
    (list initial-A initial-B initial-C)

  py:run "initialize(nl_mode,nl_parameters,nl_initial)"

  read-state

  set sweep-results []
  set sweep-pass-percent 0

  draw-view

  reset-ticks
  initialize-plots
  update-display

  clear-output

  output-print (word "Live model: " active-mode)

  output-print
    (word "Baseline C: " (precision baseline-C 6))

  output-print
    (word "Baseline settled? " baseline-settled?)

  output-print
    "Select a ligand level, then click Apply stimulus."

  output-print
    "Input stays at its applied value until changed again."

  output-print
    "Run batch reads the CURRENT parameter widgets."

  if not baseline-settled? [
    output-print
      "WARNING: baseline is unsettled. This affects adaptation validity."
  ]

  set ready? true
end


to reset-simulation
  setup
end


;; ============================================================
;; LIVE SIMULATION
;; ============================================================

to go
  if not ready? [
    user-message "Click Setup / Reset first."
    stop
  ]

  if event-finished? [
    stop
  ]

  py:run "advance()"

  read-state
  update-display

  tick

  if event-finished? [
    print-summary
    stop
  ]
end


to apply-stimulus
  if not ready? [
    user-message "Click Setup / Reset first."
    stop
  ]

  if abs (ligand-level - current-input) < 0.000000001 [
    user-message "Choose a different ligand level."
    stop
  ]

  py:set "nl_ligand" ligand-level
  py:run "apply_stimulus(nl_ligand)"

  read-state
  update-display

  output-print ""

  output-print
    (word
      "Stimulus at time "
      (precision simulation-time 2)
      ": input = "
      current-input)

  output-print
    "Metrics now refer to this latest stimulus event."

  if not baseline-settled? [
    output-print
      "WARNING: stimulus occurred before equilibration."
  ]

  display
end


to read-state
  let result py:runresult "export_state()"

  set simulation-time item 0 result

  set activity-A item 1 result
  set activity-B item 2 result
  set activity-C item 3 result

  set current-input item 4 result

  set baseline-C item 5 result
  set baseline-settled? item 6 result

  set recovery-error item 7 result
  set peak-response item 8 result

  set sensitivity-score item 9 result
  set precision-score item 10 result

  set recovery-time item 11 result
  set run-status item 12 result
  set event-finished? item 13 result
end


;; ============================================================
;; MOTIF TEXT
;; ============================================================

to-report motif-structure
  let selected motif-mode

  if ready? = true [
    set selected active-mode
  ]

  if selected = "NFBLB" [
    report "I -> A; A -> C; C -> B; B inhibits C"
  ]

  if selected = "IFFLP" [
    report "I -> A; A -> B; A -> C; B inhibits C"
  ]

  report "Choose a motif"
end


;; ============================================================
;; VIEW
;; ============================================================

to draw-view
  resize-world -8 8 -6 6
  set-patch-size 27

  ask patches [
    set pcolor white
  ]

  make-node "I" -6 1
  make-node "A" -2 1
  make-node "B" 2 4
  make-node "C" 5 1

  connect-nodes "I" "A" "+"
  connect-nodes "A" "C" "+"

  ifelse active-mode = "NFBLB" [
    connect-nodes "C" "B" "+"
  ] [
    connect-nodes "A" "B" "+"
  ]

  connect-nodes "B" "C" "INHIBITS"

  create-cell-markers 1 [
    setxy -5 -3
    set shape "circle"
    set size 2
    set label-color black
  ]

  ask patch 1 -3 [
    set plabel "Marker: output relative to baseline"
    set plabel-color black
  ]

  ask patch 1 -4 [
    set plabel "Green: in band | red: above | blue: below"
    set plabel-color black
  ]

  ask patch 1 -5 [
    set plabel "Use plots and scores to assess adaptation."
    set plabel-color black
  ]
end


to make-node [title xpos ypos]
  create-motif-nodes 1 [
    set node-name title
    setxy xpos ypos
    set shape "circle"
    set size 1.6
    set label-color black
  ]
end


to connect-nodes [source-name target-name edge-label]
  let source-node
    one-of motif-nodes with [node-name = source-name]

  let target-node
    one-of motif-nodes with [node-name = target-name]

  ask source-node [
    create-regulation-to target-node [
      set label edge-label
      set label-color black
      set thickness 0.15

      ifelse edge-label = "INHIBITS" [
        set color red
      ] [
        set color gray
      ]
    ]
  ]
end


;; ============================================================
;; PLOTS
;; ============================================================

to initialize-plots
  set-current-plot "Input stimulus"
  set-plot-x-range 0 320
  set-plot-y-range 0 2

  create-temporary-plot-pen "Applied input"
  set-plot-pen-color black

  set-current-plot "Output and recovery band"
  set-plot-x-range 0 320
  set-plot-y-range 0 1

  foreach ["C" "Baseline" "Upper 2%" "Lower 2%"] [
    pen-name ->
    create-temporary-plot-pen pen-name
  ]

  set-current-plot-pen "C"
  set-plot-pen-color red

  set-current-plot-pen "Baseline"
  set-plot-pen-color black

  set-current-plot-pen "Upper 2%"
  set-plot-pen-color gray

  set-current-plot-pen "Lower 2%"
  set-plot-pen-color gray

  set-current-plot "Internal activities"
  set-plot-x-range 0 320
  set-plot-y-range 0 1

  foreach ["A" "B" "C"] [
    pen-name ->
    create-temporary-plot-pen pen-name
  ]

  set-current-plot-pen "A"
  set-plot-pen-color blue

  set-current-plot-pen "B"
  set-plot-pen-color green

  set-current-plot-pen "C"
  set-plot-pen-color red

  set-current-plot "Batch results"
  set-plot-x-range 0 44
  set-plot-y-range 0 5

  create-temporary-plot-pen "Recovery error"
  set-plot-pen-mode 1

  create-temporary-plot-pen "2% error limit"
  set-plot-pen-color black
end


to update-display
  ask motif-nodes [
    if node-name = "I" [set activity current-input]
    if node-name = "A" [set activity activity-A]
    if node-name = "B" [set activity activity-B]
    if node-name = "C" [set activity activity-C]

    set label
      (word node-name " = " (precision activity 3))

    ifelse node-name = "I" [
      set color gray
    ] [
      set color scale-color blue activity 0 1
    ]
  ]

  ask cell-markers [
    ifelse not baseline-settled? [
      set color gray
      set label "Unsettled baseline"
    ] [
      let deviation
        (activity-C - baseline-C) / baseline-C

      ifelse abs deviation <= 0.02 [
        set color green
        set label "Within recovery band"
      ] [
        ifelse deviation > 0 [
          set color red
          set label "Above baseline"
        ] [
          set color blue
          set label "Below baseline"
        ]
      ]
    ]
  ]

  set-current-plot "Input stimulus"
  set-current-plot-pen "Applied input"
  plotxy simulation-time current-input

  set-current-plot "Output and recovery band"

  set-current-plot-pen "C"
  plotxy simulation-time activity-C

  set-current-plot-pen "Baseline"
  plotxy simulation-time baseline-C

  set-current-plot-pen "Upper 2%"
  plotxy simulation-time (baseline-C * 1.02)

  set-current-plot-pen "Lower 2%"
  plotxy simulation-time (baseline-C * 0.98)

  set-current-plot "Internal activities"

  set-current-plot-pen "A"
  plotxy simulation-time activity-A

  set-current-plot-pen "B"
  plotxy simulation-time activity-B

  set-current-plot-pen "C"
  plotxy simulation-time activity-C
end


;; ============================================================
;; INTERACTIVE RESULTS
;; ============================================================

to print-summary
  output-print ""
  output-print "===== LIVE ADAPTATION RESULTS ====="

  output-print
    (word "Maximum final-window error: "
      (precision recovery-error 5) "%")

  output-print
    (word "Peak output deviation: "
      (precision peak-response 3) "%")

  output-print
    (word "Sensitivity S: "
      (precision sensitivity-score 4))

  output-print
    (word "Conservative precision P: "
      (precision precision-score 3))

  output-print
    (word "Observed recovery time: "
      (precision recovery-time 2))

  output-print run-status
end


;; ============================================================
;; RUN BATCH
;; Reads current widgets, not the live model's old parameters.
;; Does not rebuild or change the live simulation.
;; ============================================================

to run-batch
  if not ready? [
    user-message
      "Click Setup / Reset once to connect Python. Then run the batch."
    stop
  ]

  if not valid-settings? [
    stop
  ]

  ;; Snapshot the CURRENT interface values.
  let batch-mode motif-mode
  let batch-parameters current-parameters

  let batch-initial
    (list initial-A initial-B initial-C)

  py:set "batch_mode" batch-mode
  py:set "batch_parameters" batch-parameters
  py:set "batch_initial" batch-initial

  output-print ""
  output-print "===== BATCH RESULTS ====="

  output-print
    (word "Batch motif: " batch-mode)

  output-print
    (word
      "Current k values: "
      (list k1 k2 k3 k4 k5 k6))

  output-print
    "Running 2 reference tests and 40 perturbed tests..."

  output-print
    "The interface may pause while Python calculates."

  display

  let result
    py:runresult
      "run_batch(batch_mode,batch_parameters,batch_initial)"

  set sweep-results item 0 result
  set sweep-pass-percent item 1 result

  set-current-plot "Batch results"
  clear-plot

  create-temporary-plot-pen "Recovery error"
  set-plot-pen-mode 1

  create-temporary-plot-pen "2% error limit"
  set-plot-pen-color black

  set-plot-x-range 0 44

  let largest-error
    max (map [row -> item 2 row] sweep-results)

  set-plot-y-range
    0
    (max (list 5 (largest-error * 1.1)))

  set-current-plot-pen "2% error limit"
  plotxy 0 2
  plotxy 44 2

  set-current-plot-pen "Recovery error"

  let number 0

  foreach sweep-results [
    row ->

    set number number + 1

    ifelse item 8 row [
      set-plot-pen-color green
    ] [
      set-plot-pen-color red
    ]

    plotxy number (item 2 row)

    output-print
      (word
        number ". " (item 0 row)
        " | I=" (item 1 row)
        " | error=" (precision (item 2 row) 3) "%"
        " | S=" (precision (item 4 row) 3)
        " | " (item 10 row))
  ]

  output-print ""

  output-print
    (word
      "Reference tests passed: "
      (item 4 result)
      "/2")

  output-print
    (word
      "Perturbed tests passed: "
      (item 2 result)
      "/"
      (item 3 result)
      " = "
      (precision sweep-pass-percent 1)
      "%")

  output-print
    "Parameters: 20 independent draws; all 12 kinetic parameters multiplied by factors from 0.8 to 1.25."

  output-print
    "Inputs per draw: 1 -> 1.2 and 1 -> 1.5."

  output-print
    "Green bars passed ALL criteria. Red bars failed one or more."

  output-print
    "The live simulation was not changed."

  output-print
    "CSV export: type export-robustness in the Command Center."
end


;; ============================================================
;; CSV EXPORT
;; ============================================================

to export-robustness
  if not ready? [
    user-message "Click Setup first."
    stop
  ]

  if empty? sweep-results [
    user-message "Run batch first."
    stop
  ]

  let destination user-new-file

  if destination = false [stop]

  py:set "csv_path" destination
  py:run "save_sweep(csv_path)"
end]]></code>
