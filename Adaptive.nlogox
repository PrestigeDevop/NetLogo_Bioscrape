    </chooser>
    <button x="340" y="85" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="130" display="NFBLB defaults">nfblb-defaults</button>
    <button x="225" y="85" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="110" display="IFFLP defaults">ifflp-defaults</button>
