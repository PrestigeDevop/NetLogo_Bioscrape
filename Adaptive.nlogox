    <button x="20" y="10" height="95" disableUntilTicks="false" forever="false" kind="Observer" width="190" display="Setup">Setup</button>
    <chooser x="225" y="15" height="60" variable="motif-mode" current="0" width="250" display="motif-mode">
      <choice type="string" value="NFBLB"></choice>
