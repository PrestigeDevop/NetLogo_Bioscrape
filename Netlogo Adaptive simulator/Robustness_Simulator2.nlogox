<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[extensions [py]

globals [
  ready?
  ordered-patches

  ;; Configuration: edit values in setup.
  python-path
  model-mode
  diffusion-value
  shock-amount
  automatic-shock-time

  simulation-time
  time-step
  initial-ligand
  receptor-vR
  receptor-vB

  shock-applied?
  shock-column
  ligand-color-maximum
]

patches-own [
  site-id
  ligand-level
  intermediate-level
  output-level
  target-output
]


;; ============================================================
;; SETUP
;; ============================================================

to setup
  clear-all
  set ready? false

  ;; ----------------------------------------------------------
  ;; EDIT MODEL SETTINGS HERE
  ;; ----------------------------------------------------------

  set python-path
    "D:/programmes/Anaconda/python.exe"

  ;; Choose exactly one:
  ;; "Integral feedback"
  ;; "IFFLP"
  set model-mode "Integral feedback"

  set diffusion-value 0.5
  set shock-amount 20
  set automatic-shock-time 10

  set time-step 0.2
  set initial-ligand 1.0
  set receptor-vR 0.5
  set receptor-vB 1.0

  ;; ----------------------------------------------------------

  resize-world -3 3 -3 3
  set-patch-size 50

  set simulation-time 0
  set shock-applied? false

  set shock-column
    min-pxcor + floor (world-width / 4)

  set ligand-color-maximum
    max (list 2 (initial-ligand + shock-amount))

  ask patches [
    set site-id
      ((pycor - min-pycor) * world-width
        + (pxcor - min-pxcor))

    set ligand-level initial-ligand
    set intermediate-level 0

    set target-output receptor-vR / receptor-vB
    set output-level target-output

    set plabel ""
  ]

  set ordered-patches sort-on [site-id] patches

  py:setup python-path

  define-python-model

  py:set "nl_width" world-width
  py:set "nl_height" world-height
  py:set "nl_D" diffusion-value
  py:set "nl_L0" initial-ligand
  py:set "nl_vR" receptor-vR
  py:set "nl_vB" receptor-vB
  py:set "nl_mode" model-mode

  py:run
    "build_model(int(nl_width), int(nl_height), nl_D, nl_L0, nl_vR, nl_vB, nl_mode)"

  copy-state-from-python

  ;; One stationary cell marker per compartment.
  ask patches [
    sprout 1 [
      set shape "default"
      set heading random 360
      set size 0.75
      set color green
    ]
  ]

  set ready? true

  update-visuals
  reset-ticks
end


;; ============================================================
;; PYTHON / BIOSCRAPE
;; ============================================================

to define-python-model
  (py:run
    "import numpy as np"
    "from bioscrape.types import Model"
    "from bioscrape.simulator import py_simulate_model"
    ""
    "def build_model(width, height, D, L0, vR, vB, mode):"
    "    global model, state, species_names"
    "    global ligand_names, intermediate_names, output_names"
    "    global model_width, model_height"
    ""
    "    if width < 3 or height < 3:"
    "        raise ValueError('Grid must be at least 3 by 3')"
    "    if D < 0 or L0 <= 0 or vR <= 0 or vB <= 0:"
    "        raise ValueError('Invalid model parameters')"
    "    if mode not in ('Integral feedback', 'IFFLP'):"
    "        raise ValueError('Unknown model mode')"
    ""
    "    model_width = width"
    "    model_height = height"
    "    n = width * height"
    ""
    "    ligand_names = ['L_' + str(i) for i in range(n)]"
    "    intermediate_names = ['X_' + str(i) for i in range(n)]"
    "    output_names = ['A_' + str(i) for i in range(n)]"
    ""
    "    species_names = ("
    "        ligand_names + intermediate_names + output_names"
    "    )"
    ""
    "    parameters = ["
    "        ('vR', float(vR)),"
    "        ('vB', float(vB)),"
    "        ('kone', 1.0),"
    "        ('klig', 0.05),"
    "        ('kdiff', float(D))"
    "    ]"
    ""
    "    reactions = []"
    "    state = {}"
    ""
    "    a0 = float(vR) / float(vB)"
    ""
    "    if mode == 'Integral feedback':"
    "        x0 = (0.05 * float(L0) + float(vB)) * a0"
    "    else:"
    "        x0 = float(vB) * float(L0)"
    ""
    "    for i in range(n):"
    "        L = ligand_names[i]"
    "        X = intermediate_names[i]"
    "        A = output_names[i]"
    ""
    "        state[L] = float(L0)"
    "        state[X] = x0"
    "        state[A] = a0"
    ""
    "        if mode == 'Integral feedback':"
    "            reactions.extend(["
    "                ([], [X], 'massaction', {'k': 'vR'}),"
    "                ([X], [A], 'massaction', {'k': 'kone'}),"
    "                ([L, A], [L, X], 'massaction', {'k': 'klig'}),"
    "                ([A], [], 'massaction', {'k': 'vB'})"
    "            ])"
    ""
    "        else:"
    "            reactions.extend(["
    "                ([L], [L, X], 'massaction', {'k': 'vB'}),"
    "                ([X], [], 'massaction', {'k': 'kone'}),"
    "                ([L], [L, A], 'massaction', {'k': 'vR'}),"
    "                ([X, A], [X], 'massaction', {'k': 'kone'})"
    "            ])"
    ""
    "    # Periodic diffusion, grid spacing = 1."
    "    for y in range(height):"
    "        for x in range(width):"
    "            i = y * width + x"
    ""
    "            neighbors = ["
    "                y * width + (x + 1) % width,"
    "                y * width + (x - 1) % width,"
    "                ((y + 1) % height) * width + x,"
    "                ((y - 1) % height) * width + x"
    "            ]"
    ""
    "            for j in neighbors:"
    "                reactions.append(("
    "                    [ligand_names[i]],"
    "                    [ligand_names[j]],"
    "                    'massaction',"
    "                    {'k': 'kdiff'}"
    "                ))"
    ""
    "    model = Model("
    "        species=species_names,"
    "        reactions=reactions,"
    "        parameters=parameters,"
    "        initial_condition_dict=state"
    "    )"
    ""
    ""
    "def advance_bioscrape(dt):"
    "    global state"
    ""
    "    if dt <= 0:"
    "        raise ValueError('Time step must be positive')"
    ""
    "    model.set_species({"
    "        name: float(state[name])"
    "        for name in species_names"
    "    })"
    ""
    "    result = py_simulate_model("
    "        timepoints=np.array([0.0, float(dt)]),"
    "        Model=model,"
    "        stochastic=False"
    "    )"
    ""
    "    last = result.iloc[-1]"
    ""
    "    state = {"
    "        name: float(last[name])"
    "        for name in species_names"
    "    }"
    ""
    "    if not all(np.isfinite(v) for v in state.values()):"
    "        raise FloatingPointError('Non-finite model state')"
    ""
    ""
    "def add_shock(amount):"
    "    global state"
    ""
    "    if amount < 0:"
    "        raise ValueError('Shock must be nonnegative')"
    ""
    "    column = model_width // 4"
    ""
    "    for y in range(model_height):"
    "        i = y * model_width + column"
    "        state[ligand_names[i]] += float(amount)"
    ""
    ""
    "def export_state():"
    "    return ["
    "        [state[s] for s in ligand_names],"
    "        [state[s] for s in intermediate_names],"
    "        [state[s] for s in output_names]"
    "    ]"
  )
end


;; ============================================================
;; RUN ONE STEP
;; ============================================================

to go
  if ready? != true [
    user-message "Click Setup first."
    stop
  ]

  if (not shock-applied?) and
     (simulation-time + 0.000000001 >= automatic-shock-time) [
    apply-shock
  ]

  py:set "nl_dt" time-step
  py:run "advance_bioscrape(nl_dt)"

  copy-state-from-python

  set simulation-time simulation-time + time-step

  update-visuals
  tick
end


;; ============================================================
;; APPLY LIGAND SHOCK
;; ============================================================

to apply-shock
  if ready? != true [
    user-message "Click Setup first."
    stop
  ]

  py:set "nl_shock" shock-amount
  py:run "add_shock(nl_shock)"

  set shock-applied? true

  copy-state-from-python

  set ligand-color-maximum
    max (list
      ligand-color-maximum
      (max [ligand-level] of patches))

  update-visuals
  display
end


;; ============================================================
;; TRANSFER RESULTS TO PATCHES
;; ============================================================

to copy-state-from-python
  let result py:runresult "export_state()"

  let ligand-values item 0 result
  let intermediate-values item 1 result
  let output-values item 2 result

  (foreach
    ordered-patches
    ligand-values
    intermediate-values
    output-values
    [
      [p ligand-value intermediate-value output-value] ->

      ask p [
        set ligand-level ligand-value
        set intermediate-level intermediate-value
        set output-level output-value
      ]
    ]
  )
end


;; ============================================================
;; DISPLAY
;; ============================================================

to update-visuals
  ask patches [
    set pcolor
      scale-color blue ligand-level 0 ligand-color-maximum

    set plabel ""
  ]

  ask turtles [
    let current-output [output-level] of patch-here
    let current-target [target-output] of patch-here

    let relative-deviation
      abs (current-output - current-target) / current-target

    ifelse relative-deviation > 0.15 [
      set color red
    ] [
      set color green
    ]
  ]
end


;; ============================================================
;; CURRENT MONITOR / PLOT REPORTERS
;; ============================================================

to-report mean-output
  report mean [output-level] of patches
end

to-report mean-intermediate
  report mean [intermediate-level] of patches
end

to-report mean-ligand
  report mean [ligand-level] of patches
end

to-report local-output
  report mean [output-level] of patches with [
    pxcor = shock-column
  ]
end

to-report local-intermediate
  report mean [intermediate-level] of patches with [
    pxcor = shock-column
  ]
end

to-report local-ligand
  report mean [ligand-level] of patches with [
    pxcor = shock-column
  ]
end

to-report target-value
  if receptor-vB <= 0 [
    report 0
  ]
  report receptor-vR / receptor-vB
end

to-report disrupted-sites
  report count patches with [
    target-output > 0 and
    abs (output-level - target-output)
      / target-output > 0.15
  ]
end


;; ============================================================
;; COMPATIBILITY REPORTERS FOR EARLIER WIDGET NAMES
;; ============================================================

to-report mean-active
  report mean-output
end

to-report mean-active-receptor
  report mean-output
end

to-report disrupted-cells
  report disrupted-sites
end]]></code>
