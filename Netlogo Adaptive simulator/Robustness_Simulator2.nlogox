    <view x="380" wrappingAllowedX="true" y="20" frameRate="30.0" minPycor="-3" height="389" showTickCounter="true" patchSize="55.0" fontSize="10" wrappingAllowedY="true" width="389" tickCounterLabel="ticks" maxPycor="3" updateMode="0" maxPxcor="3" minPxcor="-3"></view>
    <button x="100" y="35" height="85" disableUntilTicks="false" forever="false" kind="Observer" width="175" display="setup">setup</button>
    <button x="35" y="140" height="95" disableUntilTicks="false" forever="true" kind="Observer" width="245" display="play/pause">go</button>
