    <slider x="1190" step="0.01" y="85" max="5" width="250" display="vR_CheR" height="50" min="0.1" direction="Horizontal" default="0.1" variable="vR_CheR"></slider>
    <plot x="1195" autoPlotX="true" yMax="1.0" autoPlotY="true" yAxis="Output A" y="150" xMin="0.0" height="375" legend="false" xMax="30.0" yMin="0.0" width="485" xAxis="Time" display="Adaptive output">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>plot count turtles</update>
      </pen>
      <pen interval="1.0" mode="0" display="Mean" color="-7500403" legend="true">
        <setup>plotxy simulation-time mean-output</setup>
        <update>plotxy simulation-time mean-output</update>
      </pen>
      <pen interval="1.0" mode="0" display="Shock column" color="-2674135" legend="true">
        <setup></setup>
