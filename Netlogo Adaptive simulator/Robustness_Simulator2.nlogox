    <plot x="870" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="Ligand L" y="15" xMin="0.0" height="235" legend="false" xMax="10.0" yMin="0.0" width="320" xAxis="Time" display="Ligand input">
