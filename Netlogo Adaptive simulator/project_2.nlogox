<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[extensions [py]

breed [motif-nodes motif-node]
directed-link-breed [regulations regulation]

motif-nodes-own [
  node-name
  activity
]

globals [
  ready?

  python-path
  backend-file

  active-mode

  simulation-time
  current-input

  activity-A
  activity-B
  activity-C

  baseline-C
  baseline-settled?

  recovery-error
  peak-response
  recovery-time
  run-status
  tail-span

  sweep-results
  sweep-pass-percent

  input-before
  input-after

  warmup-time
  step-time
  end-time
  time-step
  tolerance-percent
]


;; ============================================================
;; THESE VARIABLES COME FROM INTERFACE WIDGETS:
;;
;; k1 k2 k3 k4 k5 k6
;; initial-A initial-B initial-C
;; motif-mode
;;
;; Do not declare them in globals.
;; Keep only ONE widget for each variable.
;; ============================================================


;; ============================================================
;; PRESET PARAMETERS
;; ============================================================

to nfblb-defaults
  set motif-mode "NFBLB"

  set k1 1
  set k2 1
  set k3 0.7
  set k4 0.35
  set k5 10
  set k6 10

  set initial-A 0.5
  set initial-B 0.5
  set initial-C 0.5
end


to ifflp-defaults
  set motif-mode "IFFLP"

  set k1 1
  set k2 1
  set k3 1
  set k4 100
  set k5 10
  set k6 10

  set initial-A 0.5
  set initial-B 0.5
  set initial-C 0.5
end


;; ============================================================
;; SETUP
;; ============================================================

to setup
  clear-all

  set ready? false

  ;; ----------------------------------------------------------
  ;; EDIT THESE TWO PATHS.
  ;; ----------------------------------------------------------

  set python-path
    "D:/programmes/Anaconda/python.exe"

  set backend-file
    "C:/Users/prest/OneDrive/Desktop/adaptation_backend.py"

  ;; ----------------------------------------------------------

  if not member? motif-mode ["NFBLB" "IFFLP"] [
    user-message "Choose NFBLB or IFFLP."
    stop
  ]

  if min (list k1 k2 k3 k4 k5 k6) <= 0 [
    user-message
      "All k values must be positive. Load a preset first."
    stop
  ]

  let initial-values
    (list initial-A initial-B initial-C)

  if
    (min initial-values < 0) or
    (max initial-values > 1)
  [
    user-message
      "Initial A, B and C must be between 0 and 1."
    stop
  ]

  if not file-exists? backend-file [
    user-message
      (word
        "Cannot find adaptation_backend.py.\n\n"
        "Correct backend-file near the beginning of setup.")
    stop
  ]

  ;; Remember the mode used to construct this run.
  set active-mode motif-mode

  ;; Experiment settings.
  set input-before 1
  set input-after 2

  set warmup-time 100
  set step-time 10
  set end-time 160

  set time-step 0.05
  set tolerance-percent 2

  ;; Parameter order expected by the Python backend:
  ;; k1 k2 k3 k4 k5 k6 KIA KFA KB KFB KAC KBC
  ;;
  ;; KB means KCB for NFBLB and KAB for IFFLP.

  let parameters []

  ifelse active-mode = "NFBLB" [
    set parameters
      (list
        k1 k2 k3 k4 k5 k6
        1 1 0.0001 0.0001 1 1)
  ] [
    set parameters
      (list
        k1 k2 k3 k4 k5 k6
        1 1 0.0001 100 1 1)
  ]

  ;; Start Python.
  py:setup python-path

  ;; Load the backend.
  py:set "backend_path" backend-file

  py:run
    "exec(compile(open(backend_path, encoding='utf-8').read(), backend_path, 'exec'))"

  ;; Transfer settings.
  py:set "nl_mode" active-mode
  py:set "nl_p" parameters
  py:set "nl_initial" initial-values

  py:set "nl_i0" input-before
  py:set "nl_i1" input-after

  py:set "nl_warm" warmup-time
  py:set "nl_event" step-time
  py:set "nl_stop" end-time

  py:set "nl_dt" time-step
  py:set "nl_tol" tolerance-percent

  ;; Build and equilibrate the biochemical model.
  py:run
    "initialize(nl_mode,nl_p,nl_initial,nl_i0,nl_i1,nl_warm,nl_event,nl_stop,nl_dt,nl_tol)"

  read-state

  set sweep-results []
  set sweep-pass-percent 0

  draw-motif

  reset-ticks

  initialize-plots
  show-state

  clear-output

  output-print (word "MODEL: " active-mode)
  output-print motif-structure

  output-print
    (word
      "Input changes from "
      input-before
      " to "
      input-after
      " at time "
      step-time
      ", then remains elevated.")

  output-print
    (word
      "Pre-step baseline C: "
      (precision baseline-C 6))

  output-print
    (word
      "Baseline settled? "
      baseline-settled?)

  output-print "Click Go / Stop."

  if not baseline-settled? [
    output-print
      "WARNING: baseline has not settled."

    user-message
      (word
        "The warm-up did not reach equilibrium.\n"
        "Increase warmup-time in setup and click Setup again.")
  ]

  set ready? true
end


;; ============================================================
;; RUN
;; ============================================================

to go
  if not ready? [
    user-message "Click Setup first."
    stop
  ]

  if simulation-time >= end-time - 0.00000001 [
    stop
  ]

  py:run "advance()"

  read-state
  show-state

  tick

  if simulation-time >= end-time - 0.00000001 [
    print-adaptation-summary
    stop
  ]
end


;; ============================================================
;; READ RESULTS FROM PYTHON
;; ============================================================

to read-state
  let result py:runresult "export_state()"

  set simulation-time item 0 result

  set activity-A item 1 result
  set activity-B item 2 result
  set activity-C item 3 result

  set current-input item 4 result

  set baseline-C item 5 result
  set baseline-settled? item 6 result

  set recovery-error item 7 result
  set peak-response item 8 result
  set recovery-time item 9 result

  set run-status item 10 result
  set tail-span item 11 result
end


;; ============================================================
;; MOTIF DESCRIPTION FOR OPTIONAL MONITOR
;; ============================================================

to-report motif-structure
  let displayed-mode motif-mode

  if ready? = true [
    set displayed-mode active-mode
  ]

  if displayed-mode = "NFBLB" [
    report "I -> A; A -> C; C -> B; B inhibits C"
  ]

  if displayed-mode = "IFFLP" [
    report "I -> A; A -> B; A -> C; B inhibits C"
  ]

  report "Choose NFBLB or IFFLP"
end


;; ============================================================
;; LIVE MOTIF DIAGRAM
;; ============================================================

to draw-motif
  resize-world -8 8 -6 6
  set-patch-size 27

  ask patches [
    set pcolor white
  ]

  make-node "I" -6 0 current-input
  make-node "A" -2 0 activity-A
  make-node "B" 2 3 activity-B
  make-node "C" 5 0 activity-C

  connect-nodes "I" "A" "+"
  connect-nodes "A" "C" "+"

  ifelse active-mode = "NFBLB" [
    connect-nodes "C" "B" "+"
  ] [
    connect-nodes "A" "B" "+"
  ]

  connect-nodes "B" "C" "INHIBITS"

  ask patch 0 5 [
    set plabel active-mode
    set plabel-color black
  ]

  ask patch 0 -4 [
    set plabel "I = input; A/B/C = internal active fractions"
    set plabel-color black
  ]

  ask patch 0 -5 [
    set plabel "Red link = inhibition; node size/color = activity"
    set plabel-color black
  ]
end


to make-node [node-title xpos ypos value]
  create-motif-nodes 1 [
    set node-name node-title
    set activity value

    setxy xpos ypos

    set shape "circle"
    set size 1.8
    set label-color black
  ]
end


to connect-nodes [source-name target-name edge-sign]
  let source-node
    one-of motif-nodes with [
      node-name = source-name
    ]

  let target-node
    one-of motif-nodes with [
      node-name = target-name
    ]

  ask source-node [
    create-regulation-to target-node [
      set label edge-sign
      set label-color black
      set thickness 0.16

      ifelse edge-sign = "INHIBITS" [
        set color red
      ] [
        set color gray
      ]
    ]
  ]
end


;; ============================================================
;; INITIALIZE PLOTS
;; ============================================================

to initialize-plots

  ;; Input plot.
  set-current-plot "Input stimulus"

  set-plot-x-range 0 end-time

  set-plot-y-range
    0
    (1.2 * max (list input-before input-after))

  create-temporary-plot-pen "I: external stimulus"
  set-plot-pen-color black

  ;; Output plot.
  set-current-plot "Output and recovery band"

  set-plot-x-range 0 end-time
  set-plot-y-range 0 1

  foreach
    (list
      "C: output"
      "pre-step baseline"
      "upper tolerance"
      "lower tolerance")
    [
      pen-name ->
      create-temporary-plot-pen pen-name
    ]

  set-current-plot-pen "C: output"
  set-plot-pen-color red

  set-current-plot-pen "pre-step baseline"
  set-plot-pen-color black

  set-current-plot-pen "upper tolerance"
  set-plot-pen-color gray

  set-current-plot-pen "lower tolerance"
  set-plot-pen-color gray

  ;; Internal activities plot.
  set-current-plot "Internal activities"

  set-plot-x-range 0 end-time
  set-plot-y-range 0 1

  foreach ["A" "B" "C"] [
    pen-name ->
    create-temporary-plot-pen pen-name
  ]

  set-current-plot-pen "A"
  set-plot-pen-color blue

  set-current-plot-pen "B"
  set-plot-pen-color green

  set-current-plot-pen "C"
  set-plot-pen-color red

  ;; Robustness plot.
  set-current-plot "Robustness recovery error"

  set-plot-x-range 0 10
  set-plot-y-range 0 10

  create-temporary-plot-pen "error percent"
  set-plot-pen-mode 1
end


;; ============================================================
;; UPDATE DIAGRAM AND PLOTS
;; ============================================================

to show-state
  ask motif-nodes [
    if node-name = "I" [
      set activity current-input
    ]

    if node-name = "A" [
      set activity activity-A
    ]

    if node-name = "B" [
      set activity activity-B
    ]

    if node-name = "C" [
      set activity activity-C
    ]

    set label
      (word node-name " = " (precision activity 3))

    ifelse node-name = "I" [
      set color gray
      set size 1.8
    ] [
      set color scale-color blue activity 0 1
      set size 1.3 + activity
    ]
  ]

  set-current-plot "Input stimulus"
  set-current-plot-pen "I: external stimulus"

  plotxy simulation-time current-input

  set-current-plot "Output and recovery band"

  set-current-plot-pen "C: output"
  plotxy simulation-time activity-C

  set-current-plot-pen "pre-step baseline"
  plotxy simulation-time baseline-C

  set-current-plot-pen "upper tolerance"

  plotxy
    simulation-time
    (baseline-C * (1 + tolerance-percent / 100))

  set-current-plot-pen "lower tolerance"

  plotxy
    simulation-time
    (baseline-C * (1 - tolerance-percent / 100))

  set-current-plot "Internal activities"

  set-current-plot-pen "A"
  plotxy simulation-time activity-A

  set-current-plot-pen "B"
  plotxy simulation-time activity-B

  set-current-plot-pen "C"
  plotxy simulation-time activity-C
end


;; ============================================================
;; ADAPTATION SUMMARY
;; ============================================================

to print-adaptation-summary
  output-print ""
  output-print "===== ADAPTATION RESULTS ====="

  output-print (word "Model: " active-mode)

  output-print
    (word "Baseline settled? " baseline-settled?)

  output-print
    (word
      "Recovery error: "
      (precision recovery-error 4)
      "%")

  output-print
    (word
      "Peak output deviation: "
      (precision peak-response 3)
      "%")

  output-print
    (word
      "Final-window variation: "
      (precision tail-span 4)
      "%")

  ifelse recovery-time >= 0 [
    output-print
      (word
        "Observed recovery time after stimulus: "
        (precision recovery-time 3))
  ] [
    output-print
      "Recovery time: not demonstrated / not applicable."
  ]

  output-print (word "Status: " run-status)

  output-print
    "Click Test robustness to run the parameter sweep."
end


;; ============================================================
;; ROBUSTNESS TEST
;; ============================================================

to robustness-test
  if not ready? [
    user-message "Click Setup first."
    stop
  ]

  if simulation-time < end-time - 0.00000001 [
    user-message
      "Let the adaptation experiment finish first."
    stop
  ]

  output-print ""
  output-print "===== ROBUSTNESS TESTS ====="
  output-print "Calculating independent trials. Please wait..."

  display

  set sweep-results
    py:runresult "run_sweep()"

  set-current-plot "Robustness recovery error"

  clear-plot

  create-temporary-plot-pen "error percent"
  set-plot-pen-mode 1

  set-plot-x-range 0 10

  let largest-error
    max (map [result -> item 5 result] sweep-results)

  set-plot-y-range
    0
    (max (list 5 (largest-error * 1.2)))

  let test-number 0
  let passed-count 0

  foreach sweep-results [
    result ->

    set test-number test-number + 1

    ifelse item 9 result [
      set passed-count passed-count + 1
      set-plot-pen-color green
    ] [
      set-plot-pen-color red
    ]

    plotxy test-number (item 5 result)

    output-print
      (word
        test-number
        ". "
        (item 1 result)
        " | error="
        (precision (item 5 result) 3)
        "%"
        " | peak="
        (precision (item 6 result) 2)
        "%"
        " | PASS="
        (item 9 result))
  ]

  set sweep-pass-percent
    100 * passed-count / length sweep-results

  output-print ""

  output-print
    (word
      "Passed "
      passed-count
      " / "
      length sweep-results
      " selected tests ("
      (precision sweep-pass-percent 1)
      "%).")

  output-print
    (word
      "PASS: settled baseline; peak > 1%; "
      "recovery error <= "
      tolerance-percent
      "%; final-window variation <= 0.2%.")

  output-print
    "This selected sweep is not the paper's robustness score."

  output-print
    "Optional CSV export: enter export-robustness in the Command Center."
end


;; ============================================================
;; CSV EXPORT
;; ============================================================

to export-robustness
  if not ready? [
    user-message "Click Setup first."
    stop
  ]

  if empty? sweep-results [
    user-message "Run Test robustness first."
    stop
  ]

  let destination user-new-file

  if destination = false [
    stop
  ]

  py:set "csv_path" destination
  py:run "save_sweep(csv_path)"
end]]></code>
